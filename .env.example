# Local development values matching docker-compose.yml. Never use these elsewhere.

# Owner role: runs migrations and owns every table.
DATABASE_OWNER_URL=postgres://sethu_owner:sethu_owner_dev@localhost:54329/sethu
# App role: what the API and workers connect as. Subject to row level security.
DATABASE_URL=postgres://sethu_app:sethu_app_dev@localhost:54329/sethu
# Password given to the app role by `pnpm db:roles`.
APP_ROLE_PASSWORD=sethu_app_dev

TEST_DATABASE_OWNER_URL=postgres://sethu_owner:sethu_owner_dev@localhost:54329/sethu_test
TEST_DATABASE_URL=postgres://sethu_app:sethu_app_dev@localhost:54329/sethu_test

# Secrets the simulated payment provider signs webhooks with, comma separated.
# The first one signs; every one listed is accepted (that is how rotation works).
SIM_PAYMENTS_WEBHOOK_SECRETS=dev-only-sim-payments-secret-0000000000
